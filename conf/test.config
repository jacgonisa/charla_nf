/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run jacgonisa/charla_nf -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data for CHARLA pipeline
    reads                      = "${projectDir}/tests/data/test_sample_longreads.fastq"
    sample_id                  = "test_sample"
    input_format               = "fastq"

    // Parent accessions (using defaults)
    parent1_name               = 'Col'
    parent2_name               = 'Ler'

    // For testing, use minimal test data
    parent1_bed                = null
    parent2_bed                = null
    cenhapmer_db_dir           = "${projectDir}/tests/data/cenhapmer_db_test"
}
