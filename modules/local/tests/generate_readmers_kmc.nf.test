nextflow_process {

    name "Test Process generate_readmers_kmc"
    script "../generate_readmers_kmc.nf"
    process "generate_readmers_kmc"
    tag "modules"
    tag "modules_local"
    tag "generate_readmers_kmc"
    tag "kmc"

    test("Should generate k-mer database from FASTA - k=21") {

        when {
            process {
                """
                input[0] = tuple(
                    file(params.pipelines_testdata_base_path + 'charla_nf/test_sample.fasta', checkIfExists: true),
                    'test_sample',
                    21
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Check that KMC database files were created
                { assert process.out.size() == 1 },
                { assert process.out[0].size() == 4 }, // [kmc_pre, kmc_suf, sample_id, kmer_size]
                { assert process.out[0][0].toString().endsWith('.kmc_pre') },
                { assert process.out[0][1].toString().endsWith('.kmc_suf') },
                { assert process.out[0][2] == 'test_sample' },
                { assert process.out[0][3] == 21 }
            )
        }
    }

    test("Should generate k-mer database from FASTA - k=31") {

        when {
            process {
                """
                input[0] = tuple(
                    file(params.pipelines_testdata_base_path + 'charla_nf/test_sample.fasta', checkIfExists: true),
                    'test_sample_k31',
                    31
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.size() == 1 },
                { assert process.out[0][0].toString().contains('_k31_') },
                { assert process.out[0][3] == 31 }
            )
        }
    }

    test("Should handle different sample IDs") {

        when {
            process {
                """
                input[0] = tuple(
                    file(params.pipelines_testdata_base_path + 'charla_nf/test_sample.fasta', checkIfExists: true),
                    'ColLer_F1_pollen',
                    21
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out[0][2] == 'ColLer_F1_pollen' },
                { assert process.out[0][0].toString().contains('ColLer_F1_pollen') }
            )
        }
    }

    test("Should fail on invalid FASTA input") {

        when {
            process {
                """
                // Create an invalid file
                def invalid_file = file('test_invalid.fa')
                invalid_file.text = 'This is not a valid FASTA file\\n'

                input[0] = tuple(
                    invalid_file,
                    'test_invalid',
                    21
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.stderr.contains('ERROR') || process.stdout.contains('ERROR') }
            )
        }
    }

    test("Should process long reads") {

        when {
            process {
                """
                // Create a FASTA with longer sequences
                def long_fasta = file('test_long.fa')
                long_fasta.text = '>long_read1\\n' + 'ACGT' * 500 + '\\n>long_read2\\n' + 'GCTA' * 500 + '\\n'

                input[0] = tuple(
                    long_fasta,
                    'test_long_reads',
                    31
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out[0][0].exists() },
                { assert process.out[0][1].exists() }
            )
        }
    }
}
