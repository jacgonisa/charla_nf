nextflow_process {

    name "Test Process generate_readmers_kmc"
    script "../generate_readmers_kmc.nf"
    process "generate_readmers_kmc"
    tag "modules"
    tag "modules_local"
    tag "generate_readmers_kmc"
    tag "kmc"

    test("Should generate k-mer database - k=21") {

        when {
            process {
                """
                input[0] = tuple(
                    file("${projectDir}/tests/data/test_sample.fasta"),
                    'test_sample',
                    21
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.size() == 1 }
            )
        }
    }

    test("Should generate k-mer database - k=31") {

        when {
            process {
                """
                input[0] = tuple(
                    file("${projectDir}/tests/data/test_sample.fasta"),
                    'test_sample_k31',
                    31
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.size() == 1 }
            )
        }
    }

    test("Should fail on invalid FASTA") {

        when {
            process {
                """
                // Create an invalid file
                def invalid_file = file('test_invalid.fa')
                invalid_file.text = 'This is not a valid FASTA file\\n'

                input[0] = tuple(
                    invalid_file,
                    'test_invalid',
                    21
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.failed }
            )
        }
    }

    test("Should use stub run") {

        options "-stub"

        when {
            process {
                """
                input[0] = tuple(
                    file("${projectDir}/tests/data/test_sample.fasta"),
                    'test_stub',
                    21
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.size() == 1 }
            )
        }
    }
}
