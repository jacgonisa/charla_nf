nextflow_process {

    name "Test Process FASTQ_TO_FASTA"
    script "../fastq_to_fasta.nf"
    process "FASTQ_TO_FASTA"
    tag "modules"
    tag "modules_local"
    tag "fastq_to_fasta"

    test("Should convert FASTQ to FASTA without masking") {

        when {
            params {
                do_quality_masking = false
            }
            process {
                """
                input[0] = [
                    [ id: 'test_sample' ],
                    file("${projectDir}/tests/data/test_sample_longreads.fastq")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Check that fasta output exists
                { assert process.out.fasta.size() == 1 },
                { assert process.out.fasta[0][1].toString().endsWith('.fa') },
                // Check that masked_fasta is not produced
                { assert process.out.masked_fasta.size() == 0 || process.out.masked_fasta[0] == null },
                // Check versions file
                { assert process.out.versions }
            )
        }
    }

    test("Should convert FASTQ to FASTA with quality masking") {

        when {
            params {
                do_quality_masking = true
                min_quality = 14
            }
            process {
                """
                input[0] = [
                    [ id: 'test_sample_masked' ],
                    file("${projectDir}/tests/data/test_sample_longreads.fastq")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Check that both fasta outputs exist
                { assert process.out.fasta.size() == 1 },
                { assert process.out.fasta[0][1].toString().endsWith('.fa') },
                { assert process.out.masked_fasta.size() == 1 },
                { assert process.out.masked_fasta[0][1].toString().endsWith('_quality_masked.fa') },
                // Check versions file
                { assert process.out.versions }
            )
        }
    }

    test("Should handle compressed FASTQ input") {

        when {
            params {
                do_quality_masking = false
            }
            process {
                """
                input[0] = [
                    [ id: 'test_compressed' ],
                    file("${projectDir}/tests/data/test_sample_longreads.fastq")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fasta.size() == 1 },
                { assert process.out.fasta[0][1].toString().endsWith('.fa') }
            )
        }
    }

    test("Should use stub run") {

        options "-stub"

        when {
            params {
                do_quality_masking = false
            }
            process {
                """
                input[0] = [
                    [ id: 'test_stub' ],
                    file("${projectDir}/tests/data/test_sample_longreads.fastq")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
