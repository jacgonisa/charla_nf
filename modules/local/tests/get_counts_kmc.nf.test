nextflow_process {

    name "Test Process get_counts_kmc"
    script "../get_counts_kmc.nf"
    process "get_counts_kmc"
    tag "modules"
    tag "modules_local"
    tag "get_counts_kmc"
    tag "kmc"

    test("Should use stub run - k=21") {

        options "-stub"

        when {
            process {
                """
                // Create dummy KMC database files for stub
                def kmc_pre = file('test_sample_k21.kmc_pre')
                def kmc_suf = file('test_sample_k21.kmc_suf')
                kmc_pre.text = 'dummy'
                kmc_suf.text = 'dummy'

                input[0] = tuple(
                    kmc_pre,
                    kmc_suf,
                    file("${projectDir}/tests/data/test_sample_longreads.fastq"),
                    'test_sample',
                    21
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.size() == 1 }
            )
        }
    }

    test("Should use stub run - k=31") {

        options "-stub"

        when {
            process {
                """
                // Create dummy KMC database files for stub
                def kmc_pre = file('test_k31.kmc_pre')
                def kmc_suf = file('test_k31.kmc_suf')
                kmc_pre.text = 'dummy'
                kmc_suf.text = 'dummy'

                input[0] = tuple(
                    kmc_pre,
                    kmc_suf,
                    file("${projectDir}/tests/data/test_sample_longreads.fastq"),
                    'test_k31',
                    31
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.size() == 1 }
            )
        }
    }
}
