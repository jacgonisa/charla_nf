nextflow_process {

    name "Test Process generate_histogram_kmc"
    script "../generate_histogram_kmc.nf"
    process "generate_histogram_kmc"
    tag "modules"
    tag "modules_local"
    tag "generate_histogram_kmc"
    tag "kmc"

    test("Should use stub run - k=21") {

        options "-stub"

        when {
            process {
                """
                // Create dummy KMC database files for stub
                def kmc_pre = file('test_histo_k21.kmc_pre')
                def kmc_suf = file('test_histo_k21.kmc_suf')
                kmc_pre.text = 'dummy'
                kmc_suf.text = 'dummy'

                input[0] = tuple(
                    kmc_pre,
                    kmc_suf,
                    'test_histo',
                    21
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.histo.size() == 1 }
            )
        }
    }

    test("Should use stub run - k=31") {

        options "-stub"

        when {
            process {
                """
                // Create dummy KMC database files for stub
                def kmc_pre = file('test_histo_k31.kmc_pre')
                def kmc_suf = file('test_histo_k31.kmc_suf')
                kmc_pre.text = 'dummy'
                kmc_suf.text = 'dummy'

                input[0] = tuple(
                    kmc_pre,
                    kmc_suf,
                    'test_histo_k31',
                    31
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.histo.size() == 1 }
            )
        }
    }
}
